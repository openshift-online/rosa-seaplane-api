{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "group:allDigest"
  ],
  "enabledManagers": [
    "dockerfile",
    "gomod",
    "tekton"
  ],
  "timezone": "UTC",
  "constraints": {
    "go": "1.26"
  },
  "dockerfile": {
    "managerFilePatterns": [
      "/^Dockerfile$/",
      "/^ci\\/Containerfile$/"
    ]
  },
  "tekton": {
    "managerFilePatterns": [
      "/^\\.tekton\\/.*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Move from 2 segment to 3 segment version",
      "versioning": "loose",
      "matchPackageNames": [
        "/quay.io/konflux-ci//"
      ]
    },
    {
      "description": "Batch + automerge patch/minor/digest Containerfile/Dockerfile updates when Prow + Konflux pass",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "groupName": "dockerfile dependencies",
      "schedule": ["* 2-4 * * 1-5"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "addLabels": [
        "automerge",
        "dependencies",
        "docker",
        "lgtm",
        "approved"
      ]
    },
    {
      "description": "Require manual review for major Containerfile/Dockerfile updates",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": [
        "major-update",
        "manual-review-required",
        "dependencies",
        "docker"
      ]
    },
    {
      "description": "Never bump go/toolchain directives; Go upgrades stay manual",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang", "toolchain"],
      "enabled": false
    },
    {
      "description": "Skip module updates that require newer than Go 1.26",
      "matchManagers": ["gomod"],
      "constraintsFiltering": "strict"
    },
    {
      "description": "Batch + automerge patch/minor/digest Go module updates when Prow + Konflux pass",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "groupName": "gomod dependencies",
      "schedule": ["* 2-4 * * 1-5"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "addLabels": [
        "automerge",
        "dependencies",
        "go-modules",
        "lgtm",
        "approved"
      ]
    },
    {
      "description": "Require manual review for major Go module updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": [
        "major-update",
        "manual-review-required",
        "dependencies",
        "go-modules"
      ]
    },
    {
      "description": "Tidy updated Go modules and their local dependents (make verify-mod)",
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidyAll"]
    },
    {
      "description": "Batch + automerge Konflux Tekton reference updates when Prow + Konflux pass",
      "matchManagers": ["tekton"],
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "groupName": "tekton dependencies",
      "schedule": ["* 2-4 * * 1-5"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "addLabels": [
        "automerge",
        "dependencies",
        "lgtm",
        "approved"
      ]
    },
    {
      "description": "Require manual review for major Tekton updates",
      "matchManagers": ["tekton"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": [
        "major-update",
        "manual-review-required",
        "dependencies"
      ]
    }
  ],
  "rebaseWhen": "behind-base-branch",
  "ignoreTests": false
}
