namespace Seaplane {
    type AccountID = String;
    type Region = String;
    type RequestContext = {
        region: Region, accountId: AccountID, principalArn: String,
        sourceIp: String, userAgent: String,
        requestTime: { unixSeconds: Long, dayOfWeek: Long, hour: Long },
        requestLabels: RequestLabels
    };

    // Carries the request's labels as tags; Cedar has no map type.
    entity RequestLabels tags String;

    entity Role { account: AccountID };
    entity Principal in [Role] { account: AccountID };
    entity Collection { account: AccountID, region: Region };
    entity Cluster in [Collection] { account: AccountID, region: Region } tags String;
    entity NodePool in [Cluster, Collection] { account: AccountID, region: Region } tags String;
    entity OIDCConfig in [Collection] { account: AccountID, region: Region } tags String;
    entity DNSReservation in [Collection] { account: AccountID, region: Region } tags String;

    entity Policy in [Collection] { account: AccountID, region: Region } tags String;
    entity Attachment in [Collection] { account: AccountID, region: Region } tags String;
    entity RegionalAttachment in [Collection] { account: AccountID, region: Region } tags String;

    action PolicyAdmin;
    action RegionalAttachmentAdmin in [PolicyAdmin];
    action CreatePolicy in [PolicyAdmin] appliesTo { principal: [Principal, Role], resource: Collection, context: RequestContext };
    action ListPolicies in [PolicyAdmin] appliesTo { principal: [Principal, Role], resource: Collection, context: RequestContext };
    action DescribePolicy in [PolicyAdmin] appliesTo { principal: [Principal, Role], resource: Policy, context: RequestContext };
    action UpdatePolicy in [PolicyAdmin] appliesTo { principal: [Principal, Role], resource: Policy, context: RequestContext };
    action DeletePolicy in [PolicyAdmin] appliesTo { principal: [Principal, Role], resource: Policy, context: RequestContext };
    action CreateAttachment in [PolicyAdmin] appliesTo { principal: [Principal, Role], resource: Collection, context: RequestContext };
    action ListAttachments in [PolicyAdmin] appliesTo { principal: [Principal, Role], resource: Collection, context: RequestContext };
    action DeleteAttachment in [PolicyAdmin] appliesTo { principal: [Principal, Role], resource: Attachment, context: RequestContext };
    action CreateAttachmentRegional in [RegionalAttachmentAdmin, PolicyAdmin] appliesTo { principal: [Principal, Role], resource: Collection, context: RequestContext };
    action ListAttachmentsRegional in [RegionalAttachmentAdmin, PolicyAdmin] appliesTo { principal: [Principal, Role], resource: Collection, context: RequestContext };
    action DeleteAttachmentRegional in [RegionalAttachmentAdmin, PolicyAdmin] appliesTo { principal: [Principal, Role], resource: RegionalAttachment, context: RequestContext };

    action AllActions;
    action ReadOnly in [AllActions];
    action ClusterAdmin in [AllActions];
    action NodePoolAdmin in [AllActions];
    action OIDCConfigAdmin in [AllActions];
    action DNSReservationAdmin in [AllActions];
    action LabelAdmin in [AllActions];

    action ListLabelsForResource in [ReadOnly, AllActions] appliesTo { principal: [Principal, Role], resource: [Cluster, NodePool, OIDCConfig, DNSReservation], context: RequestContext };
    action LabelResource in [LabelAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: [Cluster, NodePool, OIDCConfig, DNSReservation], context: RequestContext };
    action UnlabelResource in [LabelAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: [Cluster, NodePool, OIDCConfig, DNSReservation], context: RequestContext };

    // cedar-go v1.8.0 validates action entities against the complete parent closure.
    action ListClusters in [ReadOnly, AllActions] appliesTo { principal: [Principal, Role], resource: Collection, context: RequestContext };
    action DescribeCluster in [ReadOnly, AllActions] appliesTo { principal: [Principal, Role], resource: Cluster, context: RequestContext };
    action CreateCluster in [ClusterAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: Cluster, context: RequestContext };
    action UpdateCluster in [ClusterAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: Cluster, context: RequestContext };
    action UpdateClusterConfig in [ClusterAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: Cluster, context: RequestContext };
    action UpdateClusterVersion in [ClusterAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: Cluster, context: RequestContext };
    action DeleteCluster in [ClusterAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: Cluster, context: RequestContext };

    action ListNodePools in [ReadOnly, AllActions] appliesTo { principal: [Principal, Role], resource: Collection, context: RequestContext };
    action DescribeNodePool in [ReadOnly, AllActions] appliesTo { principal: [Principal, Role], resource: NodePool, context: RequestContext };
    action CreateNodePool in [NodePoolAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: NodePool, context: RequestContext };
    action UpdateNodePool in [NodePoolAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: NodePool, context: RequestContext };
    action ScaleNodePool in [NodePoolAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: NodePool, context: RequestContext };
    action UpdateNodePoolVersion in [NodePoolAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: NodePool, context: RequestContext };
    action DeleteNodePool in [NodePoolAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: NodePool, context: RequestContext };

    action ListOIDCConfigs in [ReadOnly, AllActions] appliesTo { principal: [Principal, Role], resource: Collection, context: RequestContext };
    action DescribeOIDCConfig in [ReadOnly, AllActions] appliesTo { principal: [Principal, Role], resource: OIDCConfig, context: RequestContext };
    action CreateOIDCConfig in [OIDCConfigAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: OIDCConfig, context: RequestContext };
    action DeleteOIDCConfig in [OIDCConfigAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: OIDCConfig, context: RequestContext };

    action ListDNSReservations in [ReadOnly, AllActions] appliesTo { principal: [Principal, Role], resource: Collection, context: RequestContext };
    action DescribeDNSReservation in [ReadOnly, AllActions] appliesTo { principal: [Principal, Role], resource: DNSReservation, context: RequestContext };
    action CreateDNSReservation in [DNSReservationAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: DNSReservation, context: RequestContext };
    action DeleteDNSReservation in [DNSReservationAdmin, AllActions] appliesTo { principal: [Principal, Role], resource: DNSReservation, context: RequestContext };
}
